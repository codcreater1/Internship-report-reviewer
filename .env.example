# Copy to .env and adjust. Everything here is optional; the defaults are what
# the service ships with. Backend settings map to backend/app/core/config.py.

# --- AI (advisory reading + student email wording only) ---------------------
# With no key the service still decides identically: the verdict comes from
# deterministic checks. What you lose is the model's reading of the report and
# the personalised email wording, which falls back to static templates.
LLM_API_KEY=
REVIEW_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
REVIEW_LLM_MODEL=gemini-3.6-flash
REVIEW_REPORT_LANGUAGE=English

# Per-call deadline for the model, in seconds. Only the student's email is
# drafted inside the request, and it makes at most two attempts, so twice this
# is what a caller can wait - keep that under the read timeout of whatever
# proxy sits in front of this service (Cloudflare's is 100s on the free plan).
# The advisory reading runs after the response and is bounded by this too.
# REVIEW_LLM_TIMEOUT_SECONDS=20

# Tracing. With both keys set, every step of the advisory graph is traced
# separately (advisory-comprehend, advisory-audit, advisory-questions), so you
# can see which step spends what. Without them nothing changes.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=            # self-hosted; defaults to cloud.langfuse.com

# --- Security ---------------------------------------------------------------
# When set, /reports/from-n8n requires 'Authorization: Bearer <key>'. Also signs
# certificate download links — leave it empty and they are signed with a random
# per-process key, so they break on restart and across workers.
REVIEW_API_SECRET_KEY=

# --- Storage ----------------------------------------------------------------
# REVIEW_DB_PATH=/data/submissions.db
# REVIEW_STORAGE_ROOT=/data/tmp

# --- Browser origins allowed to call the API --------------------------------
# The dashboard's public URL. A JSON array, a comma-separated list, or a single
# origin all work. Get this wrong and the dashboard's calls fail in the browser
# as a CORS error.
# REVIEW_CORS_ORIGINS=https://your-dashboard.example.com

# --- Frontend (build time) ---------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000
