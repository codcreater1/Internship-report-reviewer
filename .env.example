# Copy to .env and adjust. Everything here is optional; the defaults are what
# the service ships with. Backend settings map to backend/app/core/config.py.

# --- AI (advisory reading + student email wording only) ---------------------
# With no key the service still decides identically: the verdict comes from
# deterministic checks. What you lose is the model's reading of the report and
# the personalised email wording, which falls back to static templates.
LLM_API_KEY=
REVIEW_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
REVIEW_LLM_MODEL=gemini-2.0-flash
REVIEW_REPORT_LANGUAGE=English

# Optional: trace every model call
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- Security ---------------------------------------------------------------
# When set, /reports/from-n8n requires 'Authorization: Bearer <key>'. Also signs
# certificate download links — leave it empty and they are signed with a random
# per-process key, so they break on restart and across workers.
REVIEW_API_SECRET_KEY=

# --- Storage ----------------------------------------------------------------
# REVIEW_DB_PATH=/data/submissions.db
# REVIEW_STORAGE_ROOT=/data/tmp

# --- Browser origins allowed to call the API --------------------------------
# REVIEW_CORS_ORIGINS=["https://your-dashboard.example.com"]

# --- Frontend (build time) ---------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000
